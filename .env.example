APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ru_reservation
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

RESERVATION_DEFAULT_DURATION=120

# Jam operasional venue. Keduanya berlaku untuk jam mulai maupun jam selesai,
# dan tepat pukul itu masih boleh. Kosongkan dan jatuh ke 08:00 dan 22:00.
RESERVATION_OPENING_TIME=08:00
RESERVATION_CLOSING_TIME=22:00

# Penimpa sandi awal akun yang dibuat seeder (admin roemahumara@gmail.com dan,
# kalau StaffSeeder dijalankan, sepuluh akun staf). OPSIONAL.
#
# Dikosongkan berarti "pakai sandi bawaan seeder", bukan lagi "seeder berhenti":
# sandi bawaannya ada di konstanta SANDI_BAWAAN pada trait ReadsInitialPassword
# dan tercatat di CLAUDE.md, jadi sandi yang terbentuk selalu diketahui.
#
# Isi di sini kalau server ini terbuka ke internet — sandi bawaan itu ada di
# repositori dan bisa dibaca siapa saja. Isilah SEBELUM seeder dijalankan
# pertama kali: seeder melewati akun yang sudah ada dan tidak pernah memperbaiki
# sandi yang terlanjur terpasang.
#
# JANGAN tulis nilai sungguhan di berkas contoh ini — ia ikut git. Bungkus kutip
# tunggal kalau sandinya mengandung # atau spasi.
INITIAL_USER_PASSWORD=
