<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            DB_HOST dan DB_PORT sengaja TIDAK dipatok di sini: keduanya mengikuti
            .env masing-masing mesin. Dulu port dipatok (3306, lalu 8889 saat
            disesuaikan dengan MAMP) dan akibatnya test selalu gagal menyambung
            di mesin yang MySQL-nya di port lain — gejalanya puluhan
            QueryException, bukan pesan yang menunjuk penyebabnya.

            Yang tetap dipatok hanya dua, dan keduanya memang harus sama di semua
            mesin: mysql (aturan #1 CLAUDE.md) dan database test yang terpisah.
        -->
        <!--
            Dipatok supaya test tidak bergantung pada .env tiap mesin. Nilainya
            sengaja berbeda dari nilai cadangan di config, sehingga test yang
            membandingkannya membuktikan seeder benar-benar membaca konfigurasi
            dan bukan kebetulan cocok dengan literal 'password'.
        -->
        <env name="INITIAL_USER_PASSWORD" value="sandi-uji-bukan-sandi-sungguhan"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="ru_reservation_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
