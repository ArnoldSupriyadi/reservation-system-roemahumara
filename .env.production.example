##
## Template environment PRODUKSI - Reservation System Roemah Umara
##
## Cara pakai (dijalankan SEKALI di server, bukan di-commit):
##   cp .env.production.example .env
##   php artisan key:generate
##   nano .env   # isi semua nilai CHANGE_ME
##
## File .env asli SUDAH ada di .gitignore. Jangan pernah commit .env.
##

APP_NAME="Roemah Umara Reservation"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME_DOMAIN

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# 'daily' + 14 hari retensi supaya disk VPS tidak penuh oleh laravel.log tunggal.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ----------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roemahumara
DB_USERNAME=roemahumara
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Session -----------------------------------------------------------------
# Driver 'database' butuh tabel sessions (sudah ada di migration bawaan Laravel 12).
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- Cache / Queue -----------------------------------------------------------
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail --------------------------------------------------------------------
# Ganti ke SMTP asli sebelum fitur email (konfirmasi reservasi / reset password) dipakai.
MAIL_MAILER=log
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@CHANGE_ME_DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite --------------------------------------------------------------------
# Aset di produksi di-build di CI (npm run build), bukan di server.
VITE_APP_NAME="${APP_NAME}"
